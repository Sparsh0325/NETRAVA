# IntelliShare Local Environment Configuration Template
# Copy this file to .env and configure your local credentials.
# Do NOT commit .env to version control.

# Server Configuration
PORT=8085

# Authentication (generate a random Base64-encoded key of at least 32 bytes)
JWT_SECRET=replace_with_random_base64_secret
JWT_EXPIRATION=PT1H

# Database Configuration
DB_HOST=127.0.0.1
DB_PORT=5436
DB_NAME=intellishare
DB_USERNAME=intellishare_user
DB_PASSWORD=your_secure_password_here
DB_URL=jdbc:postgresql://127.0.0.1:5436/intellishare

# Flyway Database Migration
FLYWAY_ENABLED=true

# Comma-separated allowed browser origins; set the deployed frontend URL in hosting settings.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:*

# Optional server-side AI provider. Never put this key in frontend/.env or commit the real value.
INTELLISHARE_AI_GEMINI_API_KEY=
INTELLISHARE_AI_GEMINI_MODEL=gemini-3.8-flash
